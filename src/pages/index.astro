---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Datos de ejemplo para iterar proyectos rápidamente
const projects = [
  {
    title: "Creación de página o sitio web a la medida",
    description: "Sitio web desarrollado a la medida con WordPress, incluyendo personalización de temas y plugins, optimización de rendimiento y SEO.",
    tags: ["Node.js", "Express", "Php", "Wordpress"],
    demoUrl: "https://www.dainonnihotel.com"
  },
  {
    title: "Servicios de infraestructura y redes",
    description: "Servicios de infraestructura y redes. Diseño e instalación de redes, configuración de servidores y servicios en la nube, y soporte técnico para empresas.",
    tags: ["Cisco", "Fortinet", "Linux", "Windows Server"],
    
  }
];

const skills = [
  "JavaScript (ES6+)", "TypeScript", "Node.js", "Express",
  "Astro", "HTML5 / CSS3", "Tailwind CSS", "PostgreSQL",
  "Git / GitHub", "Podman", "Java", "OCI"
];
---

<BaseLayout title="Portafolio | Desarrollador de Software">
  <!-- Sección de Presentación / Hero -->
  <section class="py-12 border-b border-slate-800/60">
    <span class="text-xs font-mono text-blue-400 font-medium">Desarrollador Web</span>
    <h1 class="text-4xl font-bold tracking-tight text-white mt-2 mb-4">
      Hola, desarrollo software robusto y escalable.
    </h1>
    <p class="text-slate-400 text-base max-w-2xl leading-relaxed">
      Estudiante de Ciencias de la Computación enfocado en crear soluciones de software eficientes, limpias y bien estructuradas.
    </p>
  </section>

  <!-- Sección de Proyectos -->
  <section id="proyectos" class="py-12 border-b border-slate-800/60">
    <h2 class="text-xl font-bold text-white mb-6">Proyectos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- Sección de Habilidades Tecnicas -->
  <section id="habilidades" class="py-12 border-b border-slate-800/60">
    <h2 class="text-xl font-bold text-white mb-6">Habilidades Técnicas</h2>
    <ul class="flex flex-wrap gap-2">
      {skills.map((skill) => (
        <li class="px-3 py-1 text-sm bg-slate-900 border border-slate-800 text-slate-300 rounded font-mono">
          {skill}
        </li>
      ))}
    </ul>
  </section>

  <!-- Sección de Contacto -->
  <section id="contacto" class="py-12">
    <h2 class="text-xl font-bold text-white mb-4">Contacto</h2>
    <p class="text-slate-400 text-sm mb-6">
      Si estás interesado en colaborar o discutir oportunidades de software, puedes contactarme directamente:
    </p>
    <div class="flex flex-wrap gap-4 text-sm font-medium">
      <a 
        href="mailto:steven.f.nav@outlook.com" 
        class="px-4 py-2 bg-slate-100 text-slate-950 font-semibold rounded hover:bg-white transition-colors"
      >
        Enviar correo electrónico
      </a>
      <a 
        href="https://github.com/tremorsnav" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-4 py-2 bg-slate-900 border border-slate-800 text-slate-200 rounded hover:border-slate-700 transition-colors"
      >
        Perfil de GitHub
      </a>
    </div>
  </section>
</BaseLayout>